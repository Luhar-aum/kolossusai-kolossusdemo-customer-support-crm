# Database
DATABASE_URL=postgresql+asyncpg://crm_user:crm_pass@postgres:5432/crm_db
SYNC_DATABASE_URL=postgresql://crm_user:crm_pass@postgres:5432/crm_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAILS_FROM=noreply@example.com

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENCRYPTION_KEY=change-me-32-byte-fernet-key-here

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Slack (optional)
SLACK_WEBHOOK_URL=

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
